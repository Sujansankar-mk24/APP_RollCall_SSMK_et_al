# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Backend runtime data (recreated by `python -m scripts.reset_demo`)
backend/rollcall.db
backend/media/
# First responders' ID photos (never shared, deleted after review)
backend/private/

# Downloaded files (recreated by `python -m scripts.download_samples`)
backend/sample_media/*
!backend/sample_media/CREDITS.md
backend/models/*.pt

# Server sharing (downloaded by scripts/share_server.sh) and its logs
backend/tools/
backend/server.log
backend/cache/

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate
demo_video/

# AI & Environments
.claude
.codex
.vercel
.env
.env.*

# Quitars is free for personal use only, so it is not shared in the public repo
ios/RollCall/Fonts/Quitars.otf
# Crature (demo edition) and Angelines Script: personal-use fonts, not shared publicly
ios/RollCall/Fonts/Crature-Demo.ttf
ios/RollCall/Fonts/AngelinesScript.otf
