<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	App Transport Security normally blocks plain "http://" connections.
	NSAllowsLocalNetworking makes an exception ONLY for local addresses
	(like localhost), so the app can reach the backend running on this Mac.
	Every other connection still has to use secure https.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
